# Required for the brainstorm agent
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token
# Required scopes: repo (or public_repo), project
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=your_github_pat_here

# Target repository (format: owner/repo)
GITHUB_REPO=amalari/event-verse

# GitHub Projects v2 (optional - leave 0 to skip)
# Project number visible in the project URL: /projects/<number>
GITHUB_PROJECT_NUMBER=0
GITHUB_PROJECT_OWNER=amalari
