
# WeMade ERP — Database Environment Variables
DB_HOST=localhost
DB_PORT=5435
DB_NAME=wemade_erp
DB_USER=postgres
DB_PASSWORD=postgres

# Tenant-scoped application role (RLS enforcement, plan A0 / V16+V77).
# Server membuka pool kedua sebagai user ini; PostgreSQL RLS hanya efektif untuk role NON-superuser.
# Role `wemade_app` dibuat oleh migrasi V16 (NOLOGIN) — untuk dipakai login, jalankan:
#   ALTER ROLE wemade_app LOGIN PASSWORD '<password yang sama dengan DB_APP_PASSWORD>';
# docker-compose mengurusnya otomatis pada volume BARU via docker/postgres-init/01-app-user.sql.
DB_APP_USER=wemade_app
DB_APP_PASSWORD=change-me-app-password


# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Object storage S3-compatible (MinIO via docker-compose).
# Kredensial WAJIB sama dengan MINIO_ROOT_USER / MINIO_ROOT_PASSWORD di docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=wemademinio
S3_SECRET_KEY=wemademinio-secret
S3_BUCKET_PO=wemade-po

DEEPSEEK_API_KEY=

# --- Agent discovery (plan A8) ------------------------------------------------------------------
# Kill-switch generator draf discovery. `koog` = agent LLM (butuh DEEPSEEK_API_KEY);
# nilai lain / kosong = agent deterministik (kata kunci, tanpa jaringan & biaya).
DISCOVERY_AGENT=deterministic
# Id model DeepSeek. Default `deepseek-flash` (diverifikasi ke GET /models 2026-09-30).
# Id yang tidak ada di katalog klien Koog tetap diteruskan apa adanya + peringatan di log.
DISCOVERY_AGENT_MODEL=deepseek-flash
# `off` = kegagalan LLM menjadi kegagalan (bukan draf kata kunci yang menyamar). Kosong = fallback aktif.
DISCOVERY_AGENT_FALLBACK=
# Evals LLM hidup (`:server:test --tests '*KoogDiscoveryLiveEvalsTest'`): butuh 1 + kunci di atas.
DISCOVERY_LIVE_EVALS=0

# --- AI helper tutorial (TRD-HELP-001) ---------------------------------------------------------
# `koog` = jawaban LLM (memakai DEEPSEEK_API_KEY di atas); nilai lain / kosong = pencocok kata kunci.
# LLM hanya melihat tutorial yang lolos wewenang pemanggil; jawaban di luar kandidat → deterministik.
HELP_AGENT=deterministic
# Kosong = model default discovery (`deepseek-flash`).
HELP_AGENT_MODEL=

# --- Draf lead AI (TRD-HELP-002) ---------------------------------------------------------------
# Saklar platform. `koog` = LLM (memakai DEEPSEEK_API_KEY); lain / kosong = regex telepon/email/pcs saja.
# Nomor & email disamarkan sebelum dikirim; nama pelanggan tetap terkirim. Setiap tenant juga harus
# opt-in lewat PUT /api/tenant/crm/ai-settings (CRM MANAGE) — default mati.
LEAD_DRAFT_AGENT=deterministic
LEAD_DRAFT_AGENT_MODEL=

# --- Konsol Builder (PLAN-builder-console M2) ---------------------------------------------------
# FR-M2-7: gerbang daftar publik tenant (`POST /api/public/onboarding/register`).
# Kosong/`off` = tertutup (jalur masuk normal: undangan owner lewat superadmin).
# `on`/`true`/`1` = form daftar publik menyala; klien membaca keadaan ini dari GET /config.
WEMADE_PUBLIC_SIGNUP=

# iPaymu sandbox — bridge webhook (TRD-PAY-001)
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_NOTIFY_URL=https://ipaymu-hook-achmad.wemakeerp.com/api/payment/ipaymu/notify
IPAYMU_OUTBOUND_PROXY=
IPAYMU_RETURN_URL=http://localhost:3001/builder/billing

PULUMI_CONFIG_PASSPHRASE=