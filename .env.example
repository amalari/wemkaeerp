# WeMade ERP — Database Environment Variables
DB_HOST=localhost
DB_PORT=5435
DB_NAME=wemade_erp
DB_USER=postgres
DB_PASSWORD=postgres

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Object storage S3-compatible (MinIO via docker-compose).
# Kredensial WAJIB sama dengan MINIO_ROOT_USER / MINIO_ROOT_PASSWORD di docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=wemademinio
S3_SECRET_KEY=wemademinio-secret
S3_BUCKET_PO=wemade-po
